# Xcode (generated by XcodeGen — never commit)
*.xcodeproj/
*.xcworkspace/
*.xcworkspace/xcuserdata/
xcuserdata/
DerivedData/
*.xcuserstate

# Swift Package Manager
.build/
.swiftpm/
Package.resolved

# XcodeGen-generated plists/entitlements
Apps/*/Info.plist
Apps/*/*.entitlements

# Local developer config (team id etc.)
Config/Local.xcconfig

# Proxy (Node / Cloudflare Workers)
proxy/node_modules/
proxy/.wrangler/
proxy/.dev.vars
proxy/dist/
proxy/coverage/

# OS / editors
.DS_Store
*.swp
.idea/
.vscode/
